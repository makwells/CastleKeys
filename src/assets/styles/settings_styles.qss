QDialog{
    background-color: #151515;
    font-size: 16pt;
}

QScrollArea{
    border: 1px solid #d3d3d3;
    border-radius: 4px;
    background-color: #18181b;
}

QLabel{
    font-size: 16pt;
}

QCheckBox{
    spacing: 5px; 
}
QCheckBox::indicator{
    background-color: #111111;
    border: 1px solid #222222;
    border-radius: 4px;
    width: 16px;
    height: 16px;
    
}

QCheckBox::indicator:hover{
    background-color: #222222;
    border-color: #626262
}

QCheckBox::indicator:checked{
    background-color: #111111;
    border-color: #626262;
     /* Можно задать кастомную иконку галочки */
    /* image: url(:/images/check.png);  */
}